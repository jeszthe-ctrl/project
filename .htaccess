# Clean page addresses (/products/…, /sets/…, /guides/…) for Apache and LiteSpeed hosts.
# The shop switches them on by itself when these rules work (FK_CLEAN tells it they do);
# Admin → Settings can force them on or off.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^ - [E=FK_CLEAN:1]
  # robots.txt is written by the shop, with this domain's sitemap address
  RewriteRule ^robots\.txt$ index.php?p=robots [L,QSA]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [QSA,L]
</IfModule>

# Compress text and cache images (photo addresses change when a photo is replaced)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType application/javascript "access plus 30 days"
</IfModule>
